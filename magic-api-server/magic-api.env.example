# ==================================================================
# magic-api 凭据模板：复制为 magic-api.env 并填入真值
#   cp magic-api.env.example magic-api.env
# magic-api.env 已被 .gitignore 排除，绝不入库。
# 全部变量均可选：不创建 magic-api.env 也可以启动，默认账号密码登录
# admin/123456（生产环境务必覆盖默认密码，并按需启用 OIDC）。
# ==================================================================

# 编辑器账号密码（对应 magic-api.security.username/password，默认 admin/123456）
# 生产环境必须覆盖！
MAGIC_API_SECURITY_USERNAME=admin
MAGIC_API_SECURITY_PASSWORD=changeit

# 统一认证（OIDC/SSO）开关（对应 magic-api.security.oauth2.enabled，默认 false）
# true 时编辑器出现「统一认证登录」按钮，需同时配置 client-id/client-secret
MAGIC_API_OAUTH2_ENABLED=false

# OIDC 应用凭据（对应 magic-api.security.oauth2.client-id/client-secret）
MAGIC_API_OAUTH2_CLIENT_ID=
MAGIC_API_OAUTH2_CLIENT_SECRET=

# OIDC 启用时是否保留账号密码登录回退（默认 true）
# true = 双登录方式并存；false = 仅 OIDC（隐藏密码表单）
MAGIC_API_SECURITY_PASSWORD_LOGIN_ENABLED=true

# 打开编辑器是否自动跳转 OIDC 授权页（默认 false）
MAGIC_API_OAUTH2_AUTO_REDIRECT=false

# MCP 端点鉴权 token（对应 magic-api.mcp.token）
# 配置后所有 /mcp/magic 请求必须携带 X-Mcp-Token 或 Authorization: Bearer <token>
# 生成方式：openssl rand -hex 32
MAGIC_API_MCP_TOKEN=
